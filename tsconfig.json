{
	"compilerOptions": {
		"baseUrl": ".",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"lib": [
			"DOM",
			"ES2020"
		],
		"paths": {
			"@shared/*": [
				"src/shared/*"
			],
			"@app/*": [
				"src/app/*"
			],
			"@ui/*": [
				"src/ui/*"
			],
			"@domain/*": [
				"src/domain/*"
			],
			"@translation/*": [
				"src/translation/*"
			],
			"@semantic/*": [
				"src/semantic/*"
			],
			"@data/*": [
				"src/data/*"
			]
		}
	},
	"include": [
		"src/**/*.ts"
	]
}
